# ==============================================================================
# Environment configuration for Apartment Booking
#
# Setup:
#   1. Copy this file to a new file named ".env" in this same folder
#      (cp .env.example .env — or just copy the file and rename the copy).
#   2. Fill in YOUR OWN values in that new .env file. Never put real secrets
#      back into this file — it is committed to git and must stay generic.
#   3. Keep every variable name below present in .env, even if you leave a
#      value blank for now. Removing a line entirely can stop the backend
#      from starting.
#
# Legend used in the comments below:
#   [FREE]     you invent the value yourself, no external account needed
#   [DEFAULT]  already set to a working value, safe to leave as-is
#   [ACCOUNT]  requires signing up for a real third-party service
# ==============================================================================

# --- Database (docker-compose starts its own Postgres container) -----------
# [FREE] Pick any values — only used between the containers, nothing
# external ever reads these.
POSTGRES_DB=apartment_booking
POSTGRES_USER=apartment_booking_user
POSTGRES_PASSWORD=changeme

# --- Backend base URL --------------------------------------------------------
# [DEFAULT] Leave as-is for local Docker use. Overridden automatically at
# runtime if NGROK_AUTHTOKEN below is set and a tunnel starts successfully.
BACKEND_URL=http://localhost:8080

# --- Admin account, created automatically on first backend startup ---------
# [FREE] Any email/password you want — this becomes your admin login.
ADMIN_EMAIL=
ADMIN_PASSWORD=SuperSecret@123

# --- JWT (login sessions) ----------------------------------------------------
# [FREE] Any long random string, e.g. generate one with: openssl rand -base64 48
# Must not be left empty, or logging in will fail.
JWT_SECRET=
# [DEFAULT] 86400000 ms = 24h. Safe to leave as-is.
JWT_EXPIRATION_MS=86400000

# --- Cloudflare Turnstile (captcha on the registration form) ---------------
# [DEFAULT] Cloudflare's official "always passes" test key — works out of
# the box, no account needed. Replace with real keys from your Cloudflare
# dashboard only if you want actual captcha protection (e.g. before
# deploying publicly). Check constants.ts (frontend) for the matching site key.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- Brevo SMTP (sends booking confirmation & password-reset emails) -------
# [ACCOUNT] Free account at https://www.brevo.com — after signing up, go to
# Settings -> SMTP & API -> SMTP and copy the login + generated key below.
#
# WITHOUT these filled in: the app still starts fine, but creating a
# reservation and requesting a password reset will both fail, because each
# sends an email as part of the same request. Everything else (browsing,
# registering, logging in) is unaffected.
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
# [ACCOUNT] Must be a sender address you verified in Brevo.
MAIL_FROM_ADDRESS=
# [DEFAULT] Display name shown to email recipients — safe to leave or change.
MAIL_FROM_NAME=Residenza Aurea

# --- PayU (sandbox payment gateway) ------------------------------------------
# [DEFAULT] PayU's public sandbox test credentials — payments work
# immediately in test mode, no account needed. Only replace these if you
# register your own PayU sandbox/production merchant account.
PAYU_POS_ID=300746
PAYU_CLIENT_ID=300746
PAYU_CLIENT_SECRET=2ee86a66e5d97e3fadc400c9f19b065d
PAYU_SECOND_KEY=b6ca15b0d1020e8094d9b5f8d163db54
PAYU_BASE_URL=https://secure.snd.payu.com

# --- ngrok (lets PayU's sandbox call back to your local machine) -----------
# [ACCOUNT] Optional. Free account at https://ngrok.com — copy your
# authtoken from the dashboard.
#
# WITHOUT it: you can still "pay" through the PayU sandbox UI, but the
# reservation will stay stuck on "awaiting payment" forever, because PayU
# has no way to reach your local backend to confirm the payment succeeded.
NGROK_AUTHTOKEN=